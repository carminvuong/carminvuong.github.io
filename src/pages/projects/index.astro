---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { profile } from '../../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const count = projects.length;
---

<Base
  title={`Projects — ${profile.name}`}
  description="Software and machine learning projects by Minh (Carmin) Vuong."
>
  <header class="pagehead frame">
    <p class="pagehead__eyebrow">{count} {count === 1 ? 'project' : 'projects'}</p>
    <h1 class="pagehead__title">Projects</h1>
    <p class="pagehead__lede">
      Things I built end to end — the data collection and the deployment included,
      not just the interesting part in the middle.
    </p>
  </header>

  <div class="band" role="presentation"></div>

  <section class="section">
    <div class="section__grid">
      <p class="section__label">Index</p>
      <div class="stack-lg">
        {projects.map((project) => <ProjectCard project={project} showYear />)}
      </div>
    </div>
  </section>
</Base>
