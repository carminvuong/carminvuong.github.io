---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RoleEntry from '../components/RoleEntry.astro';
import { profile, experience, skills } from '../data/site';
import portrait from '../assets/portrait.jpg';

const all = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// The home page shows only what's flagged featured. The full index lives at
// /projects/ — set `featured: true` in a project's frontmatter to surface it here.
// Split the subhead so the accent term can carry its own colour. Falls back to
// the plain string if the term isn't in there.
const accentAt = profile.subheadAccent ? profile.subhead.indexOf(profile.subheadAccent) : -1;
const subhead =
  accentAt === -1
    ? { before: profile.subhead, accent: '', after: '' }
    : {
        before: profile.subhead.slice(0, accentAt),
        accent: profile.subheadAccent,
        after: profile.subhead.slice(accentAt + profile.subheadAccent.length),
      };

const featured = all.filter((project) => project.data.featured);
const others = all.length - featured.length;
---

<Base title={`${profile.name} — Software Engineer`}>
  <!-- ── Hero ──────────────────────────────────────────────── -->
  <div class="hero frame">
    <div class="hero__text">
      <p class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>{profile.status}
      </p>

      <h1 class="hero__name">
        {profile.name}<span class="hero__alias">{profile.alias}</span>
      </h1>

      <p class="hero__subhead">
        {subhead.before}<span class="hero__subhead-accent">{subhead.accent}</span>{subhead.after}
      </p>

      <p class="hero__lede">{profile.lede}</p>

      <ul class="hero__links">
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
        <li><a href={profile.github}>GitHub</a></li>
        <li><a href={profile.linkedin}>LinkedIn</a></li>
        {profile.resume && <li><a href={profile.resume}>Résumé (PDF)</a></li>}
      </ul>
    </div>

    <Image
      class="hero__portrait"
      src={portrait}
      alt={`${profile.name}, ${profile.location}`}
      width={320}
      densities={[1, 2]}
      loading="eager"
    />
  </div>

  <div class="band" role="presentation"></div>

  <!-- ── Experience ────────────────────────────────────────── -->
  <Section label="Experience" id="experience">
    <div class="roles-list">
      {
        experience.map((role) => (
          <RoleEntry
            title={role.title}
            org={role.org}
            dates={role.dates}
            detail={role.detail}
          />
        ))
      }
    </div>
  </Section>

  <!-- ── Work ──────────────────────────────────────────────── -->
  <Section label="Projects" id="work">
    <div class="stack-lg">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>

    <p class="more-link">
      <a href="/projects/">
        All projects
        {others > 0 && <span class="more-link__count"> ({others} more)</span>}
        <span aria-hidden="true"> →</span>
      </a>
    </p>
  </Section>

  <!-- ── Skills ────────────────────────────────────────────── -->
  <Section label="Skills" id="skills">
    <dl class="skills">
      {
        skills.map((group) => (
          <div class="skills__row">
            <dt class="skills__label">{group.label}</dt>
            <dd class="skills__items">
              {group.items.map((item) => (
                <span>{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>
</Base>
