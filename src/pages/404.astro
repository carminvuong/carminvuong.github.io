---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Minh Vuong" description="That page doesn't exist.">
  <div class="hero frame">
    <p class="hero__status">
      <span class="hero__dot" aria-hidden="true"></span>404
    </p>
    <h1 class="hero__name">Nothing<span class="hero__alias">here</span></h1>
    <p class="hero__lede">
      That page doesn't exist — it may have moved, or the link may be mistyped.
    </p>
    <ul class="hero__links">
      <li><a href="/">Back to the homepage</a></li>
      <li><a href="/#work">Selected work</a></li>
    </ul>
  </div>
  <div class="band" role="presentation"></div>
</Base>
